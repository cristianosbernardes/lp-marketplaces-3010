{
  "redirects": [
    { "source": "/", "destination": "/lista-de-espera", "permanent": false }
  ],
  "rewrites": [
    { "source": "/lista-de-espera", "destination": "/lista-de-espera.html" },
    { "source": "/links", "destination": "/links.html" },
    {
      "source": "/((?!assets/|api/|.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/lp",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
